<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!-- Default document -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>

    <!-- PHP via FastCGI (requires PHP Manager or manual FastCGI handler) -->
    <handlers>
      <remove name="PHP_via_FastCGI" />
      <add name="PHP_via_FastCGI"
           path="*.php"
           verb="GET,HEAD,POST"
           modules="FastCgiModule"
           scriptProcessor="C:\PHP\php-cgi.exe"
           resourceType="File"
           requireAccess="Script" />
    </handlers>

    <!-- Block direct access to sensitive files -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="vendor" />
          <add segment=".env" />
        </hiddenSegments>
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".log"  allowed="false" />
          <add fileExtension=".sql"  allowed="false" />
          <add fileExtension=".lock" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <!-- Custom error pages -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="403" />
      <remove statusCode="404" />
      <error statusCode="403" path="/index.php" responseMode="ExecuteURL" />
      <error statusCode="404" path="/index.php" responseMode="ExecuteURL" />
    </httpErrors>

  </system.webServer>
</configuration>
