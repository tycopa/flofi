# Copy this file to .env and fill in your values.
# In IIS, set these as Application Settings in the site's web.config
# or via the Application Pool's environment variables — do NOT commit .env to git.

DB_DSN=pgsql:host=127.0.0.1;port=5432;dbname=your_db
DB_USER=your_db_user
DB_PASS=your_db_password

MAIL_FROM=info@flofi.me
MAIL_USER=info@flofi.me
MAIL_PASS=your_smtp_password
MAIL_HOST=mail.flofi.me
MAIL_PORT=465
MAIL_SECURE=ssl
